# Backend base URL. Leave empty in dev (Vite proxies /api to localhost:3000).
VITE_API_URL=
# Support address shown on the Support page and in "Forgot password?" help.
VITE_SUPPORT_EMAIL=

# Firebase Analytics (optional). From Firebase console > Project settings > Your apps > Web app config.
# These are public identifiers, not secrets. Leave empty to turn analytics off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Analytics only runs in production builds; set to true to test it with `npm run dev`.
VITE_ANALYTICS_IN_DEV=
